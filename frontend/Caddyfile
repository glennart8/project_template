# Enda vägen in till systemet. Vanlig http, rätt bakom Entra Application Proxy.
# https ända fram till servern: se docs/extra.md.
:80 {
	encode

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Allt annat är frontend. Okända sökvägar ger index.html, så att
	# React kan sköta sina egna adresser.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
