APP_NAME=MyApp
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Portarna på din dator. Byt om ett annat projekt redan använder dem — byt då
# även porten i DATABASE_URL ovan.
DB_PORT=5432
WEB_PORT=8080
LOG_LEVEL=INFO
SQL_ECHO=false

# Utan Application Proxy framför appen: en fast testanvändare.
AUTH_MODE=mock
MOCK_USER=DEVUSER
MOCK_GROUPS=["dev-admin"]

# Entra-gruppens ObjectId per roll. Lokalt ett påhittat id som testanvändaren har.
ADMIN_GROUP=dev-admin
